BGCOLOR = #0f172a
COLOR = #38bdf8
TITLE = BYTE:// Network Documentation Station
COLOR = #94a3b8
SUBTITLE = Welcome to the Official ByteScript Manual

TEXT = ByteScript is the native, ultra-secure, line-by-line configuration layout language used to render web stations across the BYTE network ecosystem. It completely removes the need for heavy HTML boilerplate.

HR = TRUE

COLOR = #38bdf8
SUBTITLE = Core Command Syntax Reference
COLOR = #94a3b8
TEXT = Use these primary commands to construct your page layouts. Colors will automatically apply to elements declared after a COLOR switch.

BOX = #1e293b | #334155 | TITLE = Page Title | Set primary headers
BOX = #1e293b | #334155 | SUBTITLE = Subheading | Create structural sections
BOX = #1e293b | #334155 | TEXT = Paragraph content | Render standard descriptive body text
BOX = #1e293b | #334155 | HR = TRUE | Insert a soft, matching divider rule line

HR = TRUE

COLOR = #38bdf8
SUBTITLE = Interactive & Advanced UI Elements
COLOR = #94a3b8
TEXT = For links, boxes, warnings, and embedded media, use the pip-separated (|) parameter syntax below:

BOX = #1e293b | #334155 | ALERT = Warning: Entering non-secure sector!
BOX = #1e293b | #334155 | LINK = Visit Home Station | byte://bithome.box
BOX = #1e293b | #334155 | IMAGE = 300 | 200 | https://worlds194.github.io/ByteWeb/assets/banner.png
BOX = #1e293b | #334155 | BOX = #0f172a | #ef4444 | Inside a special outer display container layout block!

HR = TRUE

COLOR = #e2e8f0
SUBTITLE = Full Code Template Example
COLOR = #64748b
TEXT = Copy this block into any .byte file to test a clean station buildout layout:

BOX = #0f172a | #334155 | BGCOLOR = #0f172a\nCOLOR = #38bdf8\nTITLE = Alpha Station\nCOLOR = #ffffff\nTEXT = Running on the Backend Yield Terrific Engine.\nHR = TRUE\nALERT = All local terminal protocols active.

HR = TRUE

COLOR = #38bdf8
CENTER = LINK = Return to System Hub | byte://bithome.box
