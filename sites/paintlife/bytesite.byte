TITLE = BYTE:// Pixel Canvas Studio
COLOR = #94a3b8
SUBTITLE = 16x16 Matrix Sprite Matrix Constructor

HR = TRUE

COLOR = #e2e8f0
TEXT = Click on the grid blocks below to paint your sprite layout. Select your target filament or pixel color node from the control strip.

SCRIPTBOX = #1e293b | #334155 | <div id="palette" style="text-align:left; margin-bottom:15px;"><span style="color:#94a3b8; font-weight:bold; font-size:14px; margin-right:10px;">Select Color:</span><button onclick="setColor('#ef4444')" style="background:#ef4444; width:24px; height:24px; border:2px solid #ffffff; margin-right:5px; cursor:pointer; border-radius:4px;"></button><button onclick="setColor('#3b82f6')" style="background:#3b82f6; width:24px; height:24px; border:none; margin-right:5px; cursor:pointer; border-radius:4px;"></button><button onclick="setColor('#10b981')" style="background:#10b981; width:24px; height:24px; border:none; margin-right:5px; cursor:pointer; border-radius:4px;"></button><button onclick="setColor('#f59e0b')" style="background:#f59e0b; width:24px; height:24px; border:none; margin-right:5px; cursor:pointer; border-radius:4px;"></button><button onclick="setColor('#ffffff')" style="background:#ffffff; width:24px; height:24px; border:none; margin-right:5px; cursor:pointer; border-radius:4px;"></button><button onclick="setColor('#1e293b')" style="background:#1e293b; width:24px; height:24px; border:1px solid #475569; margin-right:15px; cursor:pointer; border-radius:4px;"></button><button onclick="clearCanvas()" style="background:#64748b; color:white; border:none; padding:4px 10px; font-size:12px; font-weight:bold; cursor:pointer; border-radius:4px;">Clear Grid</button></div><div id="canvasContainer" style="text-align:left;"></div><style>#paintGrid { text-align:left; background-color:#0f172a; border-collapse:collapse; margin:0; } .pCell { width:20px; height:20px; border:1px solid #334155; background-color:#1e293b; cursor:pointer; padding:0; } .pCell:hover { border-color:#64748b; }</style><script>var currentColor = '#ef4444'; var isDrawing = false; function buildCanvas() { var container = document.getElementById('canvasContainer'); container.innerHTML = ''; var table = document.createElement('table'); table.id = 'paintGrid'; for (var r = 0; r < 16; r++) { var tr = document.createElement('tr'); for (var c = 0; c < 16; c++) { var td = document.createElement('td'); td.className = 'pCell'; setupCell(td); tr.appendChild(td); } table.appendChild(tr); } container.appendChild(table); document.body.onmousedown = function() { isDrawing = true; }; document.body.onmouseup = function() { isDrawing = false; }; } function setupCell(cell) { cell.onmousedown = function(e) { e.preventDefault(); cell.style.backgroundColor = currentColor; }; cell.onmouseover = function() { if (isDrawing) { cell.style.backgroundColor = currentColor; } }; } function setColor(color, e) { currentColor = color; var buttons = document.querySelectorAll('#palette button'); buttons.forEach(function(btn) { if (btn.style.backgroundColor === color || (color === '#1e293b' && btn.innerText === 'Clear Grid')) { btn.style.border = '2px solid #ffffff'; } else if (btn.innerText !== 'Clear Grid') { btn.style.border = 'none'; } }); } function clearCanvas() { var cells = document.querySelectorAll('.pCell'); cells.forEach(function(c) { c.style.backgroundColor = '#1e293b'; }); } buildCanvas();</script>

